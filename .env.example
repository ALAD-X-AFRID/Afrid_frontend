# ──────────────────────────────────────────────────────────────────────────────
# AFRID FRONTEND — .env.example
# Copy this file to .env.local and fill in all values.
# Every variable here is required for the system to be 100% functional.
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────
# 1. BACKEND API
# ──────────────────────────────────────────────
# URL of the Go + Gin backend server
NEXT_PUBLIC_API_URL=http://localhost:8080

# ──────────────────────────────────────────────
# 2. PUBLIC URL (SEO)
# ──────────────────────────────────────────────
# Used for sitemap, robots.txt, OpenGraph metadata
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ──────────────────────────────────────────────
# 3. FIREBASE CLIENT SDK (REQUIRED)
# Find these in: Firebase Console → Project Settings → General → Your apps → Web app
# ──────────────────────────────────────────────
# API Key for web app
NEXT_PUBLIC_FIREBASE_API_KEY=
# Auth domain (usually <project-id>.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Project ID (same as backend FIREBASE_PROJECT_ID)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Storage bucket (usually <project-id>.appspot.com)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Messaging sender ID (found in Project Settings → Cloud Messaging)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# App ID for the web app
NEXT_PUBLIC_FIREBASE_APP_ID=

# ──────────────────────────────────────────────
# 4. ERROR MONITORING (Optional — leave empty to disable)
# ──────────────────────────────────────────────
# Sentry DSN for frontend error tracking
NEXT_PUBLIC_SENTRY_DSN=

# ──────────────────────────────────────────────
# 5. ANALYTICS (Optional — leave empty to disable)
# ──────────────────────────────────────────────
# PostHog product analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
