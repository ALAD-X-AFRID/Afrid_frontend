rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Contributor profiles: users can read/write only their own document. Admins can read all.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    // Tasks/sprints: authenticated users can read active tasks; only admins write.
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Submissions: contributors can create/update their own submissions and read their own.
    // Uses uid field (not contributor_id) to match frontend write pattern.
    match /submissions/{submissionId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Telemetry: authenticated users can write their own telemetry data.
    match /telemetry/{sessionId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Bot telemetry: only admins can write. Admins and authenticated users can read.
    match /bot_telemetry/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Turing test state: users can read/write only their own unlock state.
    match /turing_test_state/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // Validations: authenticated users can read/write validation entries they own or are assigned to review.
    match /validations/{validationId} {
      allow read, write: if isAuthenticated();
    }

    // Payouts: users can read only their own payout records. Backend writes via Admin SDK.
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && resource.data.contributor_id == request.auth.uid;
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
